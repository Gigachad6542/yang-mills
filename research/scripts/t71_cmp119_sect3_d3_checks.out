     c=0.25, p0=10, q=100: lam_* = 1.054 (g^2 <= 3.485e-01); sufficient closed form lam >= 1.322; closed form >= lam_*: True
     c=0.25, p0=10, q=1000: lam_* = 1.055 (g^2 <= 3.482e-01); sufficient closed form lam >= 1.492; closed form >= lam_*: True
     c=0.25, p0=15, q=5: lam_* = 1.028 (g^2 <= 3.577e-01); sufficient closed form lam >= 1.083; closed form >= lam_*: True
