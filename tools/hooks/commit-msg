#!/bin/sh
# Enforces the AGENTS.md work rules on every new commit.
#   1. Subject must be "[T<id>][<kind>] summary" with a known kind.
#   2. A [review] commit is refused unless the previous task commit was real
#      work (proof, counterexample, computation, failed-attempt or fix).
# Merge and revert commits are exempt.
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")
case "$subject" in Merge*|Revert*) exit 0 ;; esac
kind=$(printf '%s\n' "$subject" | sed -n 's/^\[T[0-9][0-9]*[a-z]*\]\[\([a-z-]*\)\] .*/\1/p')
case "$kind" in
  proof|counterexample|computation|failed-attempt|fix|infra) ;;
  review)
    prev=$(git log --format=%s 2>/dev/null | sed -n 's/^\[T[0-9][0-9]*[a-z]*\]\[\([a-z-]*\)\] .*/\1/p' | grep -v '^infra$' | head -1)
    case "$prev" in
      proof|counterexample|computation|failed-attempt|fix) ;;
      *) echo "commit-msg: a [review] commit must follow a real work commit (AGENTS.md rule 3). Last task commit kind: '${prev:-none}'." >&2; exit 1 ;;
    esac ;;
  *) echo "commit-msg: subject must look like '[T<id>][<kind>] summary', kind in proof|counterexample|computation|failed-attempt|fix|infra|review (AGENTS.md rule 5). Got: $subject" >&2; exit 1 ;;
esac
exit 0
